---
/**
 * Vprašanje razredu — mesto, kjer se ura ustavi in dijaki ugibajo, preden
 * povemo odgovor.
 *
 * Odgovor je v `<Odgovor>` znotraj in je skrit, dokler ga ne odpreš. Na
 * projekciji tako na tabli visi samo vprašanje — dijaki ne morejo prebrati
 * odgovora vnaprej.
 *
 * Na prosojnicah pišemo `oznaka={false}`: črtkan okvir pove, da gre za
 * vprašanje razredu, ime rubrike pa jemlje prostor, ki ga na projekciji ni na
 * pretek.
 */
interface Props {
  /** Ime rubrike nad vprašanjem; `false` ga izpusti. */
  oznaka?: string | false;
  /** Kdo odgovarja / kako dolgo — npr. „v paru, 2 min“. */
  kako?: string;
}

const { oznaka = 'Vprašanje razredu', kako } = Astro.props;
---

<section class="vprasanje">
  {
    oznaka !== false && (
      <p class="vprasanje__oznaka">
        {oznaka}
        {kako && <span class="vprasanje__kako"> · {kako}</span>}
      </p>
    )
  }
  <div class="vprasanje__telo"><slot /></div>
</section>
