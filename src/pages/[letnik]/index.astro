---
import Osnovna from '../../layouts/Osnovna.astro';
import {
  LETNIKI,
  LETNIKI_FT,
  enoteLetnika,
  imeLetnika,
  napredek,
  pot,
  potEnote,
  slugLetnika,
  vseUreEnote,
  type Program,
} from '../../lib/kurikulum';

export function getStaticPaths() {
  return [
    ...LETNIKI.map((n) => ({
      params: { letnik: slugLetnika(n) },
      props: { letnik: n, program: 'gim' as Program },
    })),
    ...LETNIKI_FT.map((n) => ({
      params: { letnik: slugLetnika(n, 'ft') },
      props: { letnik: n, program: 'ft' as Program },
    })),
  ];
}

interface Props {
  letnik: number;
  program: Program;
}

const { letnik, program } = Astro.props;
const enote = await enoteLetnika(letnik, program);

const zNapredkom = await Promise.all(
  enote.map(async (e) => ({
    enota: e,
    stanje: napredek(await vseUreEnote(e)),
  })),
);

const OPIS_STANJA: Record<string, string> = {
  pripravljeno: 'Pripravljeno',
  'v-pripravi': 'V pripravi',
  osnutek: 'Osnutek',
};
---

<Osnovna
  naslov={imeLetnika(letnik, program)}
  letnik={program === 'gim' ? letnik : undefined}
  drobtine={[{ napis: 'Fizika', naslov: pot() }, { napis: imeLetnika(letnik, program) }]}
>
  <div class="ovoj naslovnica">
    <h1>{imeLetnika(letnik, program)}</h1>
    <p class="naslovnica__uvod">
      70 ur, razdeljenih na {enote.length}
      {enote.length === 1 ? ' enoto' : enote.length === 2 ? ' enoti' : enote.length < 5 ? ' enote' : ' enot'}.
    </p>

    {
      program === 'ft' && (
        <p class="naslovnica__uvod">
          Ure z isto vsebino kot v gimnaziji so skupne obema programoma in imajo iste
          številke; ure preverjanja in ocenjevanja so pripravljene posebej.
        </p>
      )
    }

    <div class="kartice">
      {
        zNapredkom.map(({ enota, stanje }) => (
          <a class="kartica" href={potEnote(enota)}>
            <span class="kartica__nadnaslov">
              {enota.data.stevilka}. enota · ure {enota.data.ureOd}–{enota.data.ureDo}
            </span>
            <span class="kartica__naslov">{enota.data.naslov}</span>
            {enota.data.podnaslov && <span class="kartica__opis">{enota.data.podnaslov}</span>}
            <span class="kartica__noga">
              <span class:list={['znacka', `znacka--${enota.data.stanje}`]}>
                {OPIS_STANJA[enota.data.stanje]}
              </span>
              {stanje.skupaj > 0 && (
                <span>
                  {stanje.napisanih}/{stanje.skupaj} ur
                </span>
              )}
            </span>
          </a>
        ))
      }
    </div>

    {enote.length === 0 && <p class="ura__prazno">Za ta letnik enote še niso pripravljene.</p>}
  </div>
</Osnovna>
