---
import { render } from 'astro:content';
import Prosojnice from '../../../../layouts/Prosojnice.astro';
import { komponente } from '../../../../components/mdx';
import { potEnote, sidroUre, slugEnote, slugLetnika, vseEnote, type Enota } from '../../../../lib/kurikulum';
import { slugUre, vseProsojniceEnote, type Prosojnice as Vnos } from '../../../../lib/prosojnice';

export async function getStaticPaths() {
  // Za vsako enoto njene prosojnice — tudi gimnazijske, ki jih enota deli.
  const enote = await vseEnote();
  const poti = await Promise.all(
    enote.map(async (enota) =>
      (await vseProsojniceEnote(enota)).map((p) => ({
        params: {
          letnik: slugLetnika(enota.data.letnik, enota.data.program),
          enota: slugEnote(enota.id),
          ura: slugUre(p.data.ura),
        },
        props: { prosojnice: p, enota },
      })),
    ),
  );
  return poti.flat();
}

interface Props {
  prosojnice: Vnos;
  enota: Enota;
}

const { prosojnice, enota } = Astro.props;
const { Content } = await render(prosojnice);
---

<Prosojnice
  naslov={`Ura ${prosojnice.data.ura} · ${prosojnice.data.naslov}`}
  opis={prosojnice.data.podnaslov}
  nazaj={`${potEnote(enota)}#${sidroUre(prosojnice.data.ura)}`}
>
  <Content components={komponente} />
</Prosojnice>
