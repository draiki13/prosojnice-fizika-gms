---
/**
 * Stran enote (sklopa): glava s kriteriji uspešnosti, nato dve rubriki —
 * **Prosojnice** (za projekcijo) in **Naloge**. Obe sta seznam kartic, ena na
 * uro: kartica prosojnic odpre projekcijo, kartica nalog pa stran z nalogami
 * tiste ure. Razlage snovi tu ni: nadomeščajo jo prosojnice.
 */
import { render } from 'astro:content';
import Osnovna from '../../layouts/Osnovna.astro';
import {
  imeLetnika,
  potLetnika,
  potNalog,
  sidroUre,
  slugEnote,
  slugLetnika,
  stNalog,
  ureEnote,
  vseEnote,
  type Enota,
} from '../../lib/kurikulum';
import { potProsojnic, prosojniceEnote } from '../../lib/prosojnice';

export async function getStaticPaths() {
  const enote = await vseEnote();
  return enote.map((e) => ({
    params: { letnik: slugLetnika(e.data.letnik), enota: slugEnote(e.id) },
    props: { enota: e },
  }));
}

interface Props {
  enota: Enota;
}

const { enota } = Astro.props;
const { letnik, stevilka, naslov, podnaslov, ureOd, ureDo, kriteriji } = enota.data;

const ure = await ureEnote(letnik, stevilka);
const prosojnice = await prosojniceEnote(letnik, stevilka);

// Uvodno besedilo enote (telo datoteke v `src/content/enote/`).
const { Content: UvodEnote } = await render(enota);

// Kartice nalog — samo za ure, ki naloge zares imajo.
const kartice = ure
  .map((u) => ({ ura: u, nalog: stNalog(u) }))
  .filter(({ nalog }) => nalog > 0);

// Kartice prosojnic — za vsako uro z gradivom; ure brez prosojnic dobijo
// pripravljeno mesto, da se vidi, kaj še manjka.
const poUri = new Map(prosojnice.map((p) => [p.data.ura, p]));
const karticeProsojnic = ure
  .filter((u) => poUri.has(u.data.ura) || stNalog(u) > 0)
  .map((u) => ({ ura: u, prosojnice: poUri.get(u.data.ura) ?? null }));

/** »1 naloga · 2 nalogi · 3 naloge · 5 nalog« */
function napisNalog(n: number): string {
  const zadnji = n % 100;
  if (zadnji === 1) return `${n} naloga`;
  if (zadnji === 2) return `${n} nalogi`;
  if (zadnji === 3 || zadnji === 4) return `${n} naloge`;
  return `${n} nalog`;
}
---

<Osnovna
  naslov={naslov}
  opis={podnaslov}
  letnik={letnik}
  drobtine={[
    { napis: imeLetnika(letnik), naslov: potLetnika(letnik) },
    { napis: `${stevilka}. enota` },
  ]}
>
  <div class="enota" data-enota data-pogled="naloge">
    <div class="ovoj enota__glava">
      <div class="enota__glava-besedilo">
        <p class="enota__nadnaslov">{stevilka}. enota · ure {ureOd}–{ureDo}</p>
        <h1>{naslov}</h1>
        {podnaslov && <p class="enota__uvod">{podnaslov}</p>}
        <div class="enota__uvod besedilo"><UvodEnote /></div>
      </div>

      {
        kriteriji.length > 0 && (
          <section class="enota__kriteriji">
            <h2>Uspešen boš, če boš znal</h2>
            <ul>
              {kriteriji.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <div class="ovoj enota__telo">
      {/* ---- prosojnice ---- */}
      <section class="enota__rubrika enota__rubrika--prosojnice" id="prosojnice" aria-labelledby="naslov-prosojnic">
        <h2 id="naslov-prosojnic">Prosojnice</h2>
        {
          karticeProsojnic.length > 0 ? (
            <ol class="kartice-seznam">
              {karticeProsojnic.map(({ ura: u, prosojnice: p }) =>
                p ? (
                  <li>
                    <a href={potProsojnic(enota, u.data.ura)}>
                      <span class="ura__st">Ura {u.data.ura}</span>
                      <span class="kartice-seznam__naslov">{p.data.naslov}</span>
                      {p.data.podnaslov && (
                        <span class="kartice-seznam__podnaslov">{p.data.podnaslov}</span>
                      )}
                    </a>
                  </li>
                ) : (
                  <li>
                    <div class="kartice-seznam__prazna">
                      <span class="ura__st">Ura {u.data.ura}</span>
                      <span class="kartice-seznam__naslov">{u.data.naslov}</span>
                      <span class="kartice-seznam__st-nalog">v pripravi</span>
                    </div>
                  </li>
                ),
              )}
            </ol>
          ) : (
            <p class="enota__prazno">Prosojnice še niso pripravljene.</p>
          )
        }
      </section>

      {/* ---- naloge ---- */}
      <section class="enota__rubrika enota__rubrika--naloge" id="naloge" aria-labelledby="naslov-nalog">
        <h2 id="naslov-nalog">Naloge</h2>
        {kartice.length === 0 && <p class="enota__prazno">Naloge še niso pripravljene.</p>}
        {
          kartice.length > 0 && (
            <ol class="kartice-seznam">
              {kartice.map(({ ura: u, nalog }) => (
                <li id={sidroUre(u.data.ura)}>
                  <a href={potNalog(enota, u.data.ura)}>
                    <span class="ura__st">Ura {u.data.ura}</span>
                    <span class="kartice-seznam__naslov">{u.data.naslov}</span>
                    {u.data.matura && <span class="znacka znacka--matura">Matura</span>}
                    <span class="kartice-seznam__st-nalog">{napisNalog(nalog)}</span>
                    {u.data.povzetek && (
                      <span class="kartice-seznam__podnaslov">{u.data.povzetek}</span>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          )
        }
      </section>
    </div>
  </div>
</Osnovna>
